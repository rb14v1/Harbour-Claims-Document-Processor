# ==============================================================================
# claims-document-processor backend environment configuration
# Copy this file to `.env` and adjust values as needed. All settings are read
# via python-decouple's config() helper in config/settings.py.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core toggle
# ------------------------------------------------------------------------------
# USE_SQLITE controls two things at once:
#   1) Database engine: True -> local SQLite file (db.sqlite3), no setup needed.
#                        False -> real PostgreSQL using the POSTGRES_* vars below.
#   2) External Azure services: regardless of this flag, EACH Azure integration
#      (blob storage, document intelligence, OpenAI, AI Search) independently
#      falls back to a deterministic local stub whenever its own credentials
#      are blank. Flipping USE_SQLITE to False does NOT turn on real Azure
#      calls by itself -- you must also fill in that service's env vars.
# Default True so `manage.py test`/CI always run with zero external
# dependencies and zero cost.
USE_SQLITE=True

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# PostgreSQL (used only when USE_SQLITE=False)
# Plain relational Postgres only -- no pgvector/vector extension is required or
# used anywhere in this app. All embedding/vector storage goes through the
# Azure AI Search abstraction (backend/apps/common/search_store.py) instead.
# ------------------------------------------------------------------------------
POSTGRES_DB=claims_document_processor
POSTGRES_USER=claims_document_processor
POSTGRES_PASSWORD=claims_document_processor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Azure Blob Storage (backend/apps/common/blob_store.py)
# Optional. When AZURE_STORAGE_CONNECTION_STRING is blank, uploaded documents
# are written to/read from local disk under MEDIA_ROOT/blob_stub/<container>/.
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# Azure AI Document Intelligence (backend/apps/common/document_intelligence.py)
# Optional. When endpoint+key are blank, a deterministic stub reads the raw
# text of the uploaded document and derives fake-but-structured fields
# (vendor, amount, date, description) via regex parsing + a SHA256-seeded
# fallback, so results are reproducible across runs. In production this would
# call the prebuilt-invoice / prebuilt-receipt models.
# ------------------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# ------------------------------------------------------------------------------
# Azure OpenAI (backend/apps/common/ai.py) -- chat completions + embeddings
# Optional. When endpoint+key are blank, chat completions return deterministic
# stub text and embeddings return deterministic SHA256-seeded 1536-dim vectors.
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# Azure AI Search (backend/apps/common/search_store.py) -- vector/hybrid search
# Optional. When endpoint+key are blank, an in-process in-memory list of
# {id, vector, payload} per index name is used instead, with cosine-similarity
# top-k search implemented in plain Python. This fallback only persists for the
# lifetime of the current process (like Qdrant's :memory: mode) -- it is
# reconstructed from ClaimNarrative rows on app startup outside of tests.
# ------------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
